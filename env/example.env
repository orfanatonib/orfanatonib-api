ENVIRONMENT=local

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_NAME=your_database_name

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_bucket_name

# Email Configuration (Gmail SMTP)
GMAIL_SMTP_USER=your-account@gmail.com
GMAIL_SMTP_APP_PASSWORD=your_16_character_app_password
EMAIL_FROM_NAME=Orfanatos NIB

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=14d


# Feed Configuration
FEED_ORFANATO_PAGE_ID=00000000-0000-0000-0000-000000000000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
# Endereço do frontend, usado nos links dos e-mails.
APP_URL=http://localhost:5173
# Logo do cabeçalho dos e-mails (vale para todos os templates).
APP_LOGO_URL=

# Porta HTTP (opcional; padrão 3000).
# PORT=3000
# Origens do front aceitas por CORS, separadas por vírgula (URLs absolutas http/https).
# Sem a lista, qualquer origem é aceita com credenciais (só aceitável em desenvolvimento).
# CORS_ALLOWED_ORIGINS=https://app.exemplo.com,http://localhost:5173

# 9. OBSERVABILIDADE (registros técnicos de erro; sem corpo, query string, IP ou token)
# `file` grava JSONL local (só local/dev; é recusado em staging/prod). `dynamodb` é o destino persistente.
OBS_STORAGE=file
OBS_LOCAL_DIR=logs
# Dias de retenção (padrão 14).
OBS_TTL_DAYS=14

# 10. AUDITORIA (quem fez o quê; grava só o id do ator, nunca o nome)
AUDIT_STORAGE=file
AUDIT_LOCAL_DIR=audit
# Dias de retenção (padrão 365).
AUDIT_TTL_DAYS=365
# Janela de desduplicação de eventos idênticos, em segundos (padrão 60).
AUDIT_DEDUP_SECONDS=60

# DynamoDB (só com OBS_STORAGE/AUDIT_STORAGE=dynamodb)
# Tabela própria do Orfanato: orfanatonib-log-records-<ambiente> (nunca compartilhar com outra aplicação).
# LOG_DYNAMODB_TABLE_NAME=orfanatonib-log-records-local
# DynamoDB Local: o run.sh reaproveita o que já estiver na porta 8000 (nenhum container novo).
# LOG_DYNAMODB_ENDPOINT=http://localhost:8000
